# Example environment variables for local/dev
AZURE_OPENAI_ENDPOINT=https://foundry-ai-mc-dev.cognitiveservices.azure.com/
AZURE_OPENAI_MODEL=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_KEY=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_SERVICE_ENDPOINT=https://as-ai-sitemc-dev.search.windows.net
DOCUMENT_SEARCH_INDEX_NAME=cv-doc-chunks

# Microsoft Foundry agent creation
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
FOUNDRY_SEARCH_API_URL=
FOUNDRY_SEARCHER_WRAPPER_URL=

# Chunking defaults (chars)
AZURE_SEARCH_CHUNK_SIZE=2000
AZURE_SEARCH_CHUNK_OVERLAP=200

# Storage
AzureWebJobsStorage=
STORAGE_CONTAINER_INCOMING=incoming-cv
STORAGE_CONTAINER_NORMALIZED_MARKDOWN=normalized-cv-md
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# MCFlash
MCFLASH_CANDIDATI_URL=
MCFLASH_CANDIDATI_API_KEY=
# Endpoint di scrittura (crea/aggiorna riga candidato): DA RICEVERE.
# Finché e' vuoto la dashboard usa un MCFlash finto e non scrive nulla.
MCFLASH_CANDIDATI_WRITE_URL=
MCFLASH_CANDIDATI_WRITE_API_KEY=
# MCFlash finto (usato finche' WRITE_URL e' vuoto): tabella dello storage della Function.
MCFLASH_FAKE_TABLE_NAME=McflashFake
# Operazioni di conferma della dashboard (monitor) e storico dei CV MC sostituiti.
CV_OPERATIONS_TABLE_NAME=CvOperations
STORAGE_CONTAINER_CV_HISTORY=cv-history
STORAGE_CONTAINER_DRAFTS=cv-drafts
